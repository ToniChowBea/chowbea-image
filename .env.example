# Copy to .env for docker-compose / local runs. Never put live secrets here.

# --- API (also used by the worker replica) ---
# RabbitMQ broker URL.
CHOWBEA_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Comma-separated browser origins allowed to call the API.
CHOWBEA_CORS_ORIGINS=http://localhost:3000
# Directory for the durable jobs counter and entitlement store (volume in prod).
CHOWBEA_DATA_DIR=./data
# Reject general image-tool uploads larger than this (megabytes).
CHOWBEA_MAX_UPLOAD_MB=100
# Reject general image-tool requests with more files than this.
CHOWBEA_MAX_FILES_PER_REQUEST=100
# Decompression-bomb guard (width * height, megapixels).
CHOWBEA_MAX_IMAGE_MEGAPIXELS=300
# How long finished and abandoned job workspaces stay on disk (minutes). 60 = 1 hour.
CHOWBEA_RESULT_TTL_MINUTES=60
# RabbitMQ prefetch / concurrent jobs in a worker process.
CHOWBEA_JOB_CONCURRENCY=3
# Fixer pack: max files per evidence pack.
CHOWBEA_FIX_MAX_FILES=20
# Fixer pack: max size of one uploaded file (megabytes).
CHOWBEA_FIX_MAX_UPLOAD_MB=50
# Per-IP free /img/fix submissions allowed per minute.
CHOWBEA_FIX_FREE_RATE_PER_MINUTE=10
# Consume jobs in this process. false = HTTP publisher only (compose `api` service).
CHOWBEA_RUN_WORKER=true
# Trust X-Forwarded-For (set true behind Railway / a reverse proxy).
CHOWBEA_TRUST_FORWARDED_IP=false

# Git SHA of the running deploy (Railway sets this automatically).
RAILWAY_GIT_COMMIT_SHA=dev

# Stripe Checkout (test-mode keys). Paywall is OFF when any of these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BATCH=
STRIPE_PRICE_PASS=
# Optional HMAC secret for payment tokens. Defaults to the webhook secret.
FIX_TOKEN_SECRET=
# Public origin of the web app (Stripe success/cancel redirects).
PUBLIC_WEB_URL=http://localhost:3000

# Optional PostHog (API-side events). Off when empty. Never send file names/contents.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Web (Vite, baked in at `bun run build`) ---
VITE_API_URL=http://localhost:8000
# Public origin for sitemap, robots, canonical, and Open Graph. Defaults to
# https://img.chowbea.com when unset. Localhost may stay http://.
VITE_PUBLIC_SITE_URL=http://localhost:3000
# Optional PostHog (browser events). Off when empty.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
