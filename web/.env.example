# Base URL of the Chowbea Image API (baked in at build time).
VITE_API_URL=http://localhost:8000
# Public origin for sitemap, robots, canonical, and Open Graph. Defaults to
# https://img.chowbea.com. Localhost may stay http://; other hosts are https.
VITE_PUBLIC_SITE_URL=http://localhost:3000
# Optional PostHog project key. Empty → no browser events.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
