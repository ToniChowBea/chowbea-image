# RabbitMQ broker URL.
CHOWBEA_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Comma-separated browser origins allowed to call the API.
CHOWBEA_CORS_ORIGINS=http://localhost:3000
# Directory for the durable jobs counter (mount a volume here in prod).
CHOWBEA_DATA_DIR=./data
# General image-tool upload cap (megabytes).
CHOWBEA_MAX_UPLOAD_MB=100
CHOWBEA_MAX_FILES_PER_REQUEST=100
CHOWBEA_MAX_IMAGE_MEGAPIXELS=300
# Files auto-delete after this many minutes (1 hour).
CHOWBEA_RESULT_TTL_MINUTES=60
CHOWBEA_JOB_CONCURRENCY=3
# Fixer pack caps and free-fix rate limit.
CHOWBEA_FIX_MAX_FILES=20
CHOWBEA_FIX_MAX_UPLOAD_MB=50
CHOWBEA_FIX_FREE_RATE_PER_MINUTE=10
# true (default): this process consumes RabbitMQ jobs. false: HTTP publisher only.
CHOWBEA_RUN_WORKER=true
# Trust X-Forwarded-For when behind a proxy (Railway). Off locally.
CHOWBEA_TRUST_FORWARDED_IP=false

# Stripe Checkout (test-mode keys are fine). The batch paywall is OFF whenever
# any of these are unset — local/dev stays free. Never commit live secrets.
# Create two one-time Prices in the Stripe Dashboard (GBP): £1.99 batch pack
# and £4.99 24-hour pass, then paste the price_… ids here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BATCH=
STRIPE_PRICE_PASS=
# Optional HMAC secret for the tokens the webhook mints. Defaults to the
# webhook secret. Point Stripe at POST /billing/webhook.
FIX_TOKEN_SECRET=
# Public origin of the web app (Stripe success/cancel redirects).
PUBLIC_WEB_URL=http://localhost:3000

# Optional PostHog. Empty → no server events. Never includes file names/contents.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Ghostscript (`gs`) compresses oversized PDFs. LibreOffice converts DOC/DOCX/ODT
# to PDF. The worker Dockerfile installs both. Locally:
#   sudo apt-get install ghostscript libreoffice-writer    # Debian/Ubuntu
#   brew install ghostscript && brew install --cask libreoffice
